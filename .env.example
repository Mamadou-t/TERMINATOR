# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de donnees (PostgreSQL utilise en dev ET en prod ; mettre a False pour retomber sur SQLite)
USE_POSTGRES=True
DB_NAME=terminator_db
DB_USER=terminator_user
DB_PASSWORD=terminator_pass
DB_HOST=localhost
DB_PORT=5432

# CORS - origines autorisees du frontend (separees par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
