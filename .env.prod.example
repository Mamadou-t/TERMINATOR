# Copiez ce fichier en .env.prod sur le VPS et remplissez les valeurs.
#   cp .env.prod.example .env.prod && nano .env.prod
# Ne committez JAMAIS .env.prod (il est ignore par git).

# --- Django ---
# Generez une cle longue et aleatoire, ex :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_cle_longue_et_aleatoire
DEBUG=False
# Mettez l'IP publique du VPS (et le domaine plus tard), separes par des virgules.
ALLOWED_HOSTS=VOTRE_IP_VPS,localhost,127.0.0.1

# Meme origine (nginx sert le front et proxifie /api) => CORS non necessaire.
# A renseigner seulement si un jour le front est sur un autre domaine.
CORS_ALLOWED_ORIGINS=
# Ajoutez ici votre domaine en https quand il sera en place (ex: https://terminator.ci)
CSRF_TRUSTED_ORIGINS=

# Passe a True quand le HTTPS (domaine + Let's Encrypt) est en place.
SECURE_SSL_REDIRECT=False

# --- Base de donnees (conteneur db) ---
DB_NAME=terminator_db
DB_USER=terminator_user
DB_PASSWORD=CHANGE_ME_mot_de_passe_fort
DB_HOST=db
DB_PORT=5432
DB_SSL_REQUIRE=False
USE_POSTGRES=True
