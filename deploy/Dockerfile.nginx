# Front Terminator : build de la SPA puis service via nginx (+ proxy vers l'API).
# Construit par docker-compose (service nginx). Contexte = racine du depot front.

# --- Etape 1 : build de la SPA ---
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# URL de l'API cote client : relative => meme origine (nginx proxifie /api/v1).
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# --- Etape 2 : service statique + reverse proxy ---
FROM nginx:1.27-alpine
COPY --from=build /app/build/client /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
